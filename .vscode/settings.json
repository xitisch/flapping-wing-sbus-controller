{
  "latex-workshop.latex.outDir": "%DIR%/../output/pdf",
  "latex-workshop.latex.auxDir": "%OUTDIR%",
  "latex-workshop.latex.tools": [
    {
      "name": "pdflatex-output",
      "command": "pdflatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-halt-on-error",
        "-output-directory=%OUTDIR%",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "pdflatex twice (no Perl)",
      "tools": [
        "pdflatex-output",
        "pdflatex-output"
      ]
    }
  ],
  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.latex.clean.method": "glob",
  "latex-workshop.latex.clean.fileTypes": [
    "%DOCFILE%.aux",
    "%DOCFILE%.bbl",
    "%DOCFILE%.blg",
    "%DOCFILE%.fdb_latexmk",
    "%DOCFILE%.fls",
    "%DOCFILE%.log",
    "%DOCFILE%.out",
    "%DOCFILE%.synctex.gz",
    "%DOCFILE%.toc"
  ]
}
